# Copy to .env for LOCAL development only. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Leave empty to use a local SQLite dev database.
# TiDB Cloud example (URL-encode special characters in the password):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/thangam_hospital_db
DATABASE_URL=
# CA bundle used to verify TiDB's TLS certificate (Render/Debian default shown)
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# First administrator (only used by `flask --app app init-db` when no users exist).
# The user is forced to change this password at first login. Remove after setup.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional hospital details shown in the footer / PDFs. Leave blank until verified.
HOSPITAL_PHONE=
HOSPITAL_EMAIL=
HOSPITAL_MAP_URL=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_X=

# Feature switches
ENABLE_SIGNUP_REQUESTS=0
ENABLE_DOCTOR_PRESCRIBING=1
ENABLE_NURSE_NOTES=1
EXPIRY_WARNING_DAYS=30
SESSION_MINUTES=30
